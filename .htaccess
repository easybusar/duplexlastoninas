AddDefaultCharset UTF-8
AddType text/markdown .md
AddType text/plain .txt

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Force HTTPS
  RewriteCond %{HTTPS} off
  RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

  # Don't rewrite existing files or directories
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # 404 fallback
  RewriteCond %{DOCUMENT_ROOT}/404/index.html -f
  RewriteRule ^ 404/index.html [L]
</IfModule>

<IfModule mod_headers.c>
  # HTML, Markdown & LLM index files - always fresh
  <FilesMatch "\.(html|htm|txt|md|xml)$">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
    Header set Pragma "no-cache"
    Header set Expires "0"
  </FilesMatch>

  # Static assets - cache for performance
  <FilesMatch "\.(js|css|png|jpg|jpeg|gif|ico|svg|woff|woff2|ttf|mp4|webm)$">
    Header set Cache-Control "max-age=31536000, public, immutable"
  </FilesMatch>

  # Bloqueo estricto de indexación en buscadores para el panel de control
  <If "%{REQUEST_URI} =~ m#^/(admin|cuidador)#">
    Header set X-Robots-Tag "noindex, nofollow, noarchive, nosnippet"
  </If>
</IfModule>
